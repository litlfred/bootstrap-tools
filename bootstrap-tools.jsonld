  "label": "bootstrap-tools",
  "comment": "Generated by the bootstrap toolset (https://github.com/litlfred/bootstrap-tools, scripts/export-graph.ts) from bootstrap's own files — do not edit; change the files it describes.",
  "wasAttributedTo": "https://github.com/litlfred/bootstrap-tools",
  "title": "Bootstrap tools",
  "description": "The Zod source of bootstrap's schemas, the generators that write bootstrap's JSON Schemas, schema page and READMEs, and the checks bootstrap's content must pass — runnable by an agent, with zod, liquidjs, Playwright and bpmn-js as its dependencies.",
  "versionInfo": "0.1.0",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld#asset/agent-instructions",
      "@type": "bootstrap:Asset",
      "label": "agent-instructions",
      "title": "AGENTS.md — bootstrap-tools",
      "description": "The one-way boundary: this reads and writes bootstrap, bootstrap never imports from here, and nothing here imports above bootstrap. How an agent runs each tool, and what a Zod change does to a published contract.",
      "source": "https://litlfred.github.io/bootstrap-tools/AGENTS.md",
      "isPartOf": "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld"
    },
