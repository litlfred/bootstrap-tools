      "@id": "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld#role/github-pages",
      "@type": "bootstrap:Role",
      "label": "GitHub Pages",
      "description": "The host that serves what the Site Publisher deployed, at the publication root URL. `actedUpon`: it receives a deployment — a commit on the `gh-pages` branch — and serves it; it decides nothing, which is why it carries no skills.",
      "source": "https://litlfred.github.io/bootstrap-tools/scenarios/roles.json",
      "isPartOf": "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld#directory/bootstrap-tools-scenarios",
      "flowNodeRef": [
        "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld#process/Process_RenderKgToGitHubPages/node/A_Deploy",
        "https://litlfred.github.io/bootstrap-tools/bootstrap-tools.jsonld#process/Process_RenderKgToGitHubPages/node/A_Provision"
      ]
